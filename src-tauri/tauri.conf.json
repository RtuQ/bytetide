{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByteTide",
  "version": "0.1.0",
  "identifier": "io.github.rtuq.bytetide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ByteTide · 字节潮",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=IntensiveWakeUpThrottling,CalculateNativeWinOcclusion,--disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --disable-intensive-wake-up-throttling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}