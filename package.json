{
  "name": "bytetide",
  "private": true,
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:components": "vitest run --config vitest.components.config.ts",
    "check:version": "node scripts/check-release-version.mjs",
    "test:version": "node --test scripts/check-release-version.test.mjs",
    "check:tauri-config": "node scripts/check-tauri-config.mjs",
    "test:tauri-config": "node --test scripts/check-tauri-config.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:architecture": "node --test scripts/check-architecture.test.mjs",
    "probe:offline": "node scripts/probe-offline-1g.mjs",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@vueuse/core": "^14.4.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10"
  }
}
