{
  "name": "bytetide",
  "private": true,
  "version": "0.7.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:components": "vitest run --config vitest.components.config.ts",
    "check:version": "node scripts/check-release-version.mjs",
    "test:version": "node --test scripts/check-release-version.test.mjs",
    "bump": "node scripts/bump-version.mjs",
    "test:bump": "node --test scripts/bump-version.test.mjs",
    "check:tauri-config": "node scripts/check-tauri-config.mjs",
    "test:tauri-config": "node --test scripts/check-tauri-config.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:architecture": "node --test scripts/check-architecture.test.mjs",
    "probe:offline": "node scripts/probe-offline-1g.mjs",
    "commit": "cz",
    "release:prepare": "node scripts/prepare-release-version.mjs",
    "test:release-version": "node --test scripts/prepare-release-version.test.mjs scripts/bump-version.test.mjs scripts/check-release-version.test.mjs"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.6.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.14"
  }
}
